<%- include('../partials/head', { pageTitle: note ? 'Edit Note' : 'New Note' }) %>
<%- include('../partials/nav') %>

<main class="container">
  <h1><%= note ? 'Edit Note' : 'New Note' %></h1>

  <%- include('../partials/errors') %>

  <form
    action="<%= note ? '/notes/' + note.id + '/edit' : '/notes' %>"
    method="POST"
    class="note-form"
    novalidate
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-group">
      <label for="title">Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= typeof values !== 'undefined' && values.title ? values.title : '' %>"
        required
        maxlength="200"
        placeholder="Note title"
      />
    </div>

    <div class="form-group">
      <label for="body">Content</label>
      <textarea
        id="body"
        name="body"
        rows="16"
        maxlength="50000"
        placeholder="Write your note here…"
      ><%= typeof values !== 'undefined' && values.body ? values.body : '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= note ? 'Save changes' : 'Create note' %></button>
      <a href="<%= note ? '/notes/' + note.id : '/notes' %>" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</main>

<%- include('../partials/footer') %>
