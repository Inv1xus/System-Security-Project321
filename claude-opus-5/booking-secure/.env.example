# Copy to .env and edit before the first run:  cp .env.example .env
#
# Never commit the real .env. ADMIN_PASSWORD in particular is a live credential.

NODE_ENV=production
PORT=3000

# SQLite file. Keep it on the mounted volume so data survives a container rebuild.
DB_FILE=/data/app.db

# First-run administrator. Created only if that email does not exist yet; the
# app never overwrites an existing account's password.
# Use a long, unique password (minimum 12 characters, 3 of 4 character classes).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-Admin-Password-1!

# Cookie Secure flag: auto | always | never
#   auto   - set when the request itself arrived over HTTPS (default)
#   always - correct when a TLS-terminating proxy sits in front of the app
#   never  - plain-HTTP local testing ONLY; also disables HSTS
SECURE_COOKIES=auto

# Number of trusted reverse proxies in front of the app (0 = direct exposure).
# Only raise this to the real count: it decides which X-Forwarded-For entry is
# treated as the client IP for rate limiting.
TRUST_PROXY=0

# Extra origins permitted to send state-changing requests, comma separated.
# The app's own origin is always allowed; leave this empty unless you need it.
ALLOWED_ORIGINS=

# Sessions
SESSION_TTL_MINUTES=720
SESSION_ABSOLUTE_TTL_HOURS=168

# Policy
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_MINUTES=15
MAX_ACTIVE_BOOKINGS_PER_USER=20
MAX_SLOT_CAPACITY=100
MAX_SLOT_DURATION_MINUTES=1440

# Request ceilings (per client IP)
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_15MIN=20
RATE_LIMIT_SIGNUP_PER_HOUR=10
