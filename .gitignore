# Shared rules for every build folder in this repository.
# Several build folders also keep their own .gitignore.

.DS_Store

# Dependencies and runtime data
node_modules/
data/
tmp/
temp/

# SQLite databases
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
build/
coverage/

# Release archives: prebuilt Docker images and source zips, hundreds of MB of
# build output that each build's own build command regenerates.
dist/
*.tar
*.tar.gz
*.zip

# Editors and local backups
.vscode/
.idea/
*.bak
