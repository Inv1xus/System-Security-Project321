# Copy to .env (or pass with `docker run -e ...`) and adjust.

# Port the HTTP server listens on inside the container.
PORT=3000

# production enables strict error handling and secure defaults.
NODE_ENV=production

# Secret used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left unset, the app creates and reuses a random key file inside DATA_DIR (0600).
SESSION_SECRET=

# Directory holding the SQLite database (mount a volume here).
DATA_DIR=/data

# Set to true only when the app is served over HTTPS; it marks the
# session cookie Secure so browsers never send it over plain HTTP.
COOKIE_SECURE=false

# Number of reverse proxies in front of the app (0 = none).
# Needed for correct client IPs in rate limiting when behind a proxy.
TRUST_PROXY=0

# Session lifetime in minutes (idle timeout, rolling).
SESSION_TTL_MINUTES=120
