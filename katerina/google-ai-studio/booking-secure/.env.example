# Server configuration
PORT=3000
NODE_ENV=development

# SQLite database file path (in Docker, mount a persistent volume at /app/data)
DB_PATH="./data/appointments.db"

# Session signing secret (generate a 32+ character random string for production)
# Example: openssl rand -hex 32
SESSION_SECRET=""

# Optional: Initial administrator account seeded on startup if no admin exists yet.
# If omitted, you can initialize the first admin account once via the UI / setup endpoint.
ADMIN_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# AI Studio platform environment variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
