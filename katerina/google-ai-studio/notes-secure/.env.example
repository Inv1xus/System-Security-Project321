# Server port (defaults to 3000)
PORT=3000

# Path to SQLite database file
DB_PATH=./data/notes.db

# Optional cookie SameSite override for standalone deployments ("lax", "strict", or "none")
# Defaults to "lax" over HTTP and "none" over HTTPS (for iframe compatibility)
# COOKIE_SAME_SITE=lax

# Set to "false" in standalone production deployments to disallow iframe embedding
# ALLOW_IFRAME=false

# GEMINI_API_KEY: Required if Gemini API capabilities are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
