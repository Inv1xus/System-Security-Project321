<%- include('../partials/head', { pageTitle: note.title }) %>
<%- include('../partials/nav') %>

<main class="container">
  <div class="note-view">
    <div class="note-view-header">
      <h1><%= note.title %></h1>
      <div class="note-actions">
        <a href="/notes/<%= note.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
        <form action="/notes/<%= note.id %>/delete" method="POST" class="inline-form"
              onsubmit="return confirm('Delete this note? This cannot be undone.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-sm btn-danger">Delete</button>
        </form>
      </div>
    </div>

    <div class="note-meta">
      Created <%= new Date(note.created_at).toLocaleString('en-US') %> ·
      Updated <%= new Date(note.updated_at).toLocaleString('en-US') %>
    </div>

    <div class="note-body"><%= note.body %></div>
  </div>

  <a href="/notes" class="back-link">← Back to notes</a>
</main>

<%- include('../partials/footer') %>
